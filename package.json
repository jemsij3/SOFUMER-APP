{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:worker": "npx wrangler dev",
    "start": "node server.ts",
    "build": "vite build",
    "db:create": "npx wrangler d1 create sofumer-db",
    "db:migrate": "npx wrangler d1 migrations apply sofumer-db --remote",
    "db:migrate:local": "npx wrangler d1 migrations apply sofumer-db --local",
    "deploy": "npm run build && npx wrangler deploy --x-provision && npx wrangler d1 migrations apply sofumer-db --remote",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js .wrangler",
    "test": "vitest run",
    "test:integration": "tsx tests/integration.ts",
    "lint": "tsc --noEmit && eslint ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.12",
    "wrangler": "^4.124.0"
  }
}
