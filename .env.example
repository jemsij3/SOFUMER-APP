# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SOFUMER Telegram Bot Configuration (Independent SOFUMER Bot)
TELEGRAM_BOT_NAME="SOFUMER"
TELEGRAM_BOT_USERNAME="SofumerBot"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
MINI_APP_URL=""

# Security & Session Configuration
SESSION_SECRET=""
ADMIN_BOOTSTRAP_SECRET=""

# Development Sandbox Flag (Set to "false" in production)
ALLOW_DEV_SANDBOX="true"
