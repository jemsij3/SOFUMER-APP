# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SOFUMER Cloudflare Workers AI Configuration
# In Cloudflare Workers production, AI runs via the native `env.AI` binding (wrangler.jsonc `ai`).
# For local Node.js / Express development outside Wrangler, optionally set Cloudflare REST credentials:
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_API_TOKEN=""

# SOFUMER Telegram Bot Configuration (Independent SOFUMER Bot)
TELEGRAM_BOT_NAME="SOFUMER"
TELEGRAM_BOT_USERNAME="SofumerBot"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
MINI_APP_URL=""

# Security & Session Configuration
SESSION_SECRET=""
ADMIN_BOOTSTRAP_SECRET=""

# Development Sandbox Flag (Set to "false" in production)
ALLOW_DEV_SANDBOX="true"
