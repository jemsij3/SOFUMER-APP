# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SOFUMER Cloudflare Workers AI Configuration
# In Cloudflare Workers production, AI runs via the native `env.AI` binding (wrangler.jsonc `ai`).
# For local Node.js / Express development outside Wrangler, optionally set Cloudflare REST credentials:
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.1-8b-instruct-fast"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_API_TOKEN=""

# Required SOFUMER Telegram & Security Secrets (configure in Cloudflare Secrets for production)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
JWT_SECRET=""
ADMIN_TELEGRAM_IDS=""

# Optional Mini App URL override (defaults to request origin)
MINI_APP_URL=""
